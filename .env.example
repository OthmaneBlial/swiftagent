# Claude CLI
SWIFTAGENT_CLAUDE_PATH=
CLAUDE_MODEL=
CLAUDE_PERMISSION_MODE=default

# Any local agent that implements stable ACP over stdio. Keep every argument
# as a separate JSON string; SwiftAgent never invokes a shell.
SWIFTAGENT_ACP_COMMAND_JSON=

# Optional Codex CLI override. Authentication is owned by `codex login`.
SWIFTAGENT_CODEX_PATH=

# Optional OpenCode CLI override. Provider credentials remain owned by
# `opencode auth login`; SwiftAgent never stores or requests them.
SWIFTAGENT_OPENCODE_PATH=

# Sandbox and workspace
SWIFTAGENT_WORKSPACE_DIR=
SWIFTAGENT_SANDBOX_MODE=strict

# Server
SWIFTAGENT_PORT=8000
SWIFTAGENT_HOST=127.0.0.1
SWIFTAGENT_DEV=0
SWIFTAGENT_NO_BROWSER=0
SWIFTAGENT_DATA_DIR=

# Operational limits and exposure. Keep remote access disabled unless another
# trusted layer provides authentication and transport security.
SWIFTAGENT_TASK_TIMEOUT_SEC=900
SWIFTAGENT_MAX_FILE_BYTES=1048576
SWIFTAGENT_MAX_DIRECTORY_ENTRIES=500
SWIFTAGENT_LOG_LEVEL=INFO
SWIFTAGENT_ALLOW_REMOTE=0
